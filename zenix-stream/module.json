{
  "id": "zenix-stream",
  "name": "Zenix",
  "contentType": "video",
  "contractVersion": 3,
  "releaseTrack": "stable",
  "moduleVersion": "1.0.0",
  "version": "1.0.0",
  "versionCode": 1,
  "moduleFamilyId": "zenix_stream",
  "moduleIdentity": "SP-VID-ZENIX-STREAM",
  "moduleIdentityNumber": 2,
  "description": "Video module for https://zenix.best (films and series). Search, details and episodes via public HTML; streams resolved dynamically without bypassing CAPTCHA/gates/logins. Note: zenix.best exposes no anime catalogue (/animes and /anime/* return 404).",
  "language": "fr",
  "config": {
    "baseUrl": "https://zenix.best",
    "runtime": {
      "entry": "index.js",
      "mode": "local"
    },
    "caps": {
      "homeMaxResults": 30,
      "maxResponseBytes": 524288,
      "timeoutMs": 15000,
      "maxConcurrentRequests": 4
    },
    "capabilities": {
      "discovery_v1": true
    }
  }
}
